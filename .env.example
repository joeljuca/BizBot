# ── Telegram ──────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ── OpenAI (for opportunity analysis) ─────────────────
OPENAI_API_KEY=sk-your-openai-key-here
# Optional: override model (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# ── Database ──────────────────────────────────────────
DATABASE_URL="file:./dev.db"

# ── Scan Schedule (cron expression, default: every 6h) ─
SCAN_CRON="0 */6 * * *"

# ── Digest Schedule (cron expression, default: 8am UTC) ─
DIGEST_CRON="0 8 * * *"

# ── Digest Timezone ───────────────────────────────────
DIGEST_TIMEZONE=UTC
