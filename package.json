{
  "name": "biz-scanner-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Telegram bot that scans business forums/blogs for new opportunities and delivers daily digests",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "bot:start": "tsx src/telegram/bot.ts",
    "scan:run": "tsx src/scripts/run-scan.ts",
    "digest:run": "tsx src/scripts/run-digest.ts",
    "setup": "npm run db:generate && npm run db:push"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "axios": "^1.7.9",
    "cheerio": "^1.0.0",
    "date-fns": "^4.1.0",
    "next": "^15.3.3",
    "node-cron": "^3.0.3",
    "openai": "^4.77.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^6.9.0",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
